{
  // 프로젝트 문서 lint 규칙 (전역 지침: 프로젝트별 세부 규칙은 여기에 정의)
  //
  // 이 규칙 세트는 한국어 산문 + 표 위주 문서를 전제한다.
  // 형식 규칙은 여기서 강제하는 것만 둔다 — 산문 줄바꿈 방식을 별도 문서 규칙으로 만들지 않는다.

  // MD013(line-length): 한국어 산문은 문장 단위로 한 줄에 쓴다 — 80자 강제 하드랩 안 함.
  "MD013": false,

  // MD036(no-emphasis-as-heading): 굵은 글씨를 소제목·라벨로 쓰는 관례를 허용.
  "MD036": false,

  // MD060(table-column-style): 표 구분행을 `|---|---|` 컴팩트 스타일로 쓰는 관례를 허용.
  "MD060": false,

  // MD041(first-line-heading): `CLAUDE.md`는 `@AGENTS.md` 한 줄짜리 도구 어댑터이므로
  // 제목을 두지 않는다. 그 한 파일 때문에 규칙 전체를 끈다 — 다른 문서는 모두 h1로 시작한다.
  "MD041": false
}
